# Cut set: the settings of the current production batch
# (coincidence/run_coincidences.sh + coincidence/run_plot_wfs_all.sh).
#
# Copy this file to define a new cut set. Two names come out of it:
#   cut set   = the file name without .env (the recipe); names the fit folder
#               output/pipeline/NAME/ and the legends of compare_cutsets.py
#   sample tag = pipeline/run_pipeline.sh NAME --print-tag (the data);
#               names coincidence/saved_coincidences/TAG/ and
#               coincidence/selected_waveforms/TAG/. Cut sets that differ only
#               in waveform cuts, MODULES or TEMPLATES share one tag.
# Paths are relative to the repo.

# --- coincidence (bin/run_coincidence) -------------------------------------
# TRIGGER (channels: Mk -> 20k0 20k1, Ck -> 10k0 10k1):
#   default_coinc : trigger M3+M4 (2030..2041) vs M5+M6 (2050..2061), saves M7+M8 (2070..2081)
#   inverse_coinc : trigger M7+M8 (2070..2081) vs M1+M2 (2010..2021), saves M5+M6 (2050..2061)
#   custom_coinc  : trigger LEFT_CHANNELS vs RIGHT_CHANNELS, saves SAVE_CHANNELS
#                   (numbers and/or all, cathode, membrane), e.g.
#                     LEFT_CHANNELS="2010 2011 2020 2021"
#                     RIGHT_CHANNELS="2050 2051 2060 2061"
#                     SAVE_CHANNELS="2070 2071 2080 2081"
#   no_coinc      : no coincidence, every waveform of CHANNELS (see single_m8.env)
TRIGGER=inverse_coinc
WINDOW_TICKS=10            # coincidence window [ticks]
MIN_AMPLITUDE_ADC=0        # minimum signal amplitude on the trigger channels
# Rate-equalization thresholds; empty disables the rate cut. Runs without a
# threshold file (041523, the reference) always run without it.
RATE_THRESHOLDS=analysis/RateAnalysis_data_292kV
# Per-channel noise/signal/pre/post windows, plus an optional [peak_finder]
# section (min_height_adc, min_height_sigma; defaults 500 and 10).
INTERVALS=coincidence/waveform_intervals.ini

# --- waveform selection (bin/plot_wfs_coincidence) -------------------------
MAX_AUX_ADC=500            # noise and post-signal amplitude limit
MAX_FULL_RANGE_ADC=10000   # full-waveform amplitude limit

# --- fit (fit/waveform_fits/fitting_bertolini_avg.py) ----------------------
MODULES="M5 M6"            # channels must be saved: low -> M5 M6 ; m8 -> M7 M8
# Detector response for the fit: large_pulse (reference/large_pulse_templates,
# every module M1-M8 and C1-C8 except M2 array 1) or francesca
# (reference/spe_templates/francesca, M5-M8). See pds/modules.py.
TEMPLATES=large_pulse

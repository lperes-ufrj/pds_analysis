# Cut set: the settings of the current production batch
# (coincidence/run_coincidences.sh + coincidence/run_plot_wfs_all.sh).
#
# Copy this file to define a new cut set; the file name (without .env) is the
# cut-set name used for every output folder. Paths are relative to the repo.

# --- coincidence (bin/run_coincidence) -------------------------------------
# Trigger/saved-channel layout:
#   low : trigger 2070-2071-2080-2081 vs 2010-2011-2020-2021, saves M5+M6 (2050-2061)
#   m8  : trigger 2030-2031-2040-2041 vs 2050-2051-2060-2061, saves M7+M8 (2070-2081)
TRIGGER=low
WINDOW_TICKS=10            # coincidence window [ticks]
MIN_AMPLITUDE_ADC=0        # minimum signal amplitude on the trigger channels
# Rate-equalization thresholds; empty disables the rate cut. Runs without a
# threshold file (041523, the reference) always run without it.
RATE_THRESHOLDS=analysis/RateAnalysis_data_292kV
# Per-channel noise/signal/pre/post windows, plus an optional [peak_finder]
# section (min_height_adc, min_height_sigma; defaults 500 and 10).
INTERVALS=coincidence/waveform_intervals.ini

# --- waveform selection (bin/plot_wfs_coincidence) -------------------------
MAX_AUX_ADC=500            # noise and post-signal amplitude limit
MAX_FULL_RANGE_ADC=10000   # full-waveform amplitude limit

# --- fit (fit/waveform_fits/fitting_bertolini_avg.py) ----------------------
MODULES="M5 M6"            # low -> M5 M6 ; m8 -> M8

# Cut set "baseline_all": editable template, FULL run set (22 fields: the
# rising branch 0..155.7 kV plus 154..292 kV; the falling branch repeats
# fields and is left out). Same settings as baseline_fast.env except
# RUN_SET; edit the values below, then
#   pipeline/run_pipeline.sh baseline_all --dry-run   # check
#   pipeline/run_pipeline.sh baseline_all             # run
#
# Two names come out of this file:
#   cut set    = baseline_all (this file name); names the fit folder
#                output/pipeline/baseline_all/full/
#   sample tag = pipeline/run_pipeline.sh baseline_all --print-tag; names
#                coincidence/saved_coincidences/TAG/ and
#                coincidence/selected_waveforms/TAG/
# baseline_fast and baseline_all with the same settings share one sample tag,
# so the full pass only processes the 15 runs the fast pass did not.
#
# Variables marked [sample] change the sample tag (a new coincidence and/or
# selection). Variables marked [cuts] change the waveform selection: rerun
# with --force selection. [fit] variables only refit.

RUN_SET=full               # reduced (7 fields) | full (22 fields); --runs overrides

# ===================================================================== sample
# TRIGGER [sample] (channels: Mk -> 20k0 20k1, Ck -> 10k0 10k1)
#   default_coinc : trigger M3+M4 (2030..2041) vs M5+M6 (2050..2061),
#                   saves M7+M8 (2070..2081)          -> MODULES M7 M8
#   inverse_coinc : trigger M7+M8 (2070..2081) vs M1+M2 (2010..2021),
#                   saves M5+M6 (2050..2061)          -> MODULES M5 M6
#   custom_coinc  : trigger LEFT_CHANNELS vs RIGHT_CHANNELS, saves SAVE_CHANNELS
#   no_coinc      : no coincidence, every waveform of CHANNELS
TRIGGER=default_coinc

# --- coincidence settings (default_coinc, inverse_coinc, custom_coinc) [sample]
WINDOW_TICKS=10            # coincidence window [ticks of 16 ns]
MIN_AMPLITUDE_ADC=0        # minimum amplitude on the trigger channels
# custom_coinc only. Channel numbers and/or all, cathode (10xx), membrane (20xx)
LEFT_CHANNELS="2010 2011 2020 2021"     # M1+M2
RIGHT_CHANNELS="2050 2051 2060 2061"    # M5+M6
SAVE_CHANNELS="2070 2071 2080 2081"     # M7+M8

# --- no_coinc settings [sample]
# Channel numbers and/or all, cathode (10xx), membrane (20xx)
CHANNELS="2080 2081"
MAX_WAVEFORMS=0            # per channel and run, after the rate cut; 0 = all

# --- both [sample]
# Rate-equalization amplitude thresholds (analysis/rate_analysis.py), applied
# to the saved channels (coincidence) or to CHANNELS (no_coinc); empty = no
# rate cut. The reference run 041523 has no threshold file and always runs
# without it; 2020, 2030, 2031 and 2041 have no threshold and are skipped.
RATE_THRESHOLDS=analysis/RateAnalysis_data_292kV

# ================================================================ waveform cuts
# Per-channel noise/signal/post-signal windows, plus an optional [peak_finder]
# section (min_height_adc, min_height_sigma; defaults 500 and 10). [sample]
# for coincidences (run_coincidence reads it too), [cuts] for no_coinc.
INTERVALS=coincidence/waveform_intervals.ini
MAX_AUX_ADC=500            # [cuts] noise and post-signal amplitude limit [ADC]
MAX_FULL_RANGE_ADC=10000   # [cuts] full-waveform amplitude limit [ADC]
REQUIRE_PEAK=0             # [cuts] no_coinc only: 1 = also reject waveforms
                           #        without a significant peak
CHANNELS_PER_PASS=4        # no_coinc only: channels in memory at once
                           # (~300 MB each); does not change the result

# ====================================================================== tau fit
# Modules to fit (M1..M8, C1..C8); their channels must be selected (saved by
# the coincidence, or in CHANNELS). Empty = selection only (custom_coinc and
# no_coinc). M2 is fitted on 2021 alone; M7 does not fit (tau_s at its limit).
MODULES="M8"               # [fit]
TEMPLATES=large_pulse      # [fit] large_pulse (every module) | francesca (M5..M8)

# Cut set "baseline_m8": production settings with the default coincidence
# (trigger M3+M4 vs M5+M6, saves M7+M8 = 2070..2081), fits M8.
# Sample tag: default_coinc_w10_a0_r_292kV_888e6582
# (pipeline/run_pipeline.sh baseline_m8 --print-tag).
# Variables are explained in baseline.env.
TRIGGER=default_coinc
WINDOW_TICKS=10
MIN_AMPLITUDE_ADC=0
RATE_THRESHOLDS=analysis/RateAnalysis_data_292kV
INTERVALS=coincidence/waveform_intervals.ini
MAX_AUX_ADC=500
MAX_FULL_RANGE_ADC=10000
MODULES="M8"
TEMPLATES=large_pulse         # or francesca; see baseline.env

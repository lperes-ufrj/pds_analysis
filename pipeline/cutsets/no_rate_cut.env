# Example variation: baseline without the rate-equalization thresholds.
# Changes the coincidence itself, so it gets its own coincidence pass.
TRIGGER=low
WINDOW_TICKS=10
MIN_AMPLITUDE_ADC=0
RATE_THRESHOLDS=
INTERVALS=coincidence/waveform_intervals.ini
MAX_AUX_ADC=500
MAX_FULL_RANGE_ADC=10000
MODULES="M5 M6"

# Cut set "single_cathode" (the recipe; this file name names the fit folder
# output/pipeline/single_cathode/).
# No coincidence: every cathode channel (1010..1081), with the cuts of
# baseline_m8. Fits every cathode module C1..C8.
# Its sample tag (the data, naming coincidence/selected_waveforms/TAG/):
#   pipeline/run_pipeline.sh single_cathode --print-tag   ->  no_coinc_cathode_r_292kV_68f6bc41
TRIGGER=no_coinc           # no coincidence: every waveform of CHANNELS

# --- sample: which waveforms enter the selection (part of the sample tag) ---
# Channel numbers and/or the keywords all, cathode (10xx), membrane (20xx).
CHANNELS="cathode"
# Rate-equalization amplitude cut, as run_coincidence applies to saved
# channels; empty disables it. The reference run 041523 has no threshold
# file and always runs without it.
RATE_THRESHOLDS=analysis/RateAnalysis_data_292kV
MAX_WAVEFORMS=0            # per channel and run, after the rate cut; 0 = all

# --- waveform cuts (bin/only_selection, same cuts as plot_wfs_coincidence) --
INTERVALS=coincidence/waveform_intervals.ini
MAX_AUX_ADC=500            # noise and post-signal amplitude limit
MAX_FULL_RANGE_ADC=10000   # full-waveform amplitude limit
REQUIRE_PEAK=0             # 1: also reject waveforms without a significant peak
CHANNELS_PER_PASS=4        # channels held in memory at once (~300 MB each)

# --- tau fit (fit/waveform_fits/fitting_bertolini_avg.py) ------------------
MODULES="C1 C2 C3 C4 C5 C6 C7 C8"
TEMPLATES=large_pulse      # or francesca (M5-M8 only); see pds/modules.py

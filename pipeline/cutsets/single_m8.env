# Cut set: no coincidence. bin/only_selection takes every waveform of the
# M8 channels and applies the quality cuts of baseline_m8, so the two cut
# sets differ only by the coincidence requirement.
MODE=single
CHANNELS="2080 2081"        # channels to select; MODULES must be covered by them
# Same rate-equalization amplitude cut that run_coincidence applies to the
# saved channels; empty disables it. Runs without a threshold file (041523,
# the reference) always run without it.
RATE_THRESHOLDS=analysis/RateAnalysis_data_292kV
INTERVALS=coincidence/waveform_intervals.ini

# --- waveform selection (bin/only_selection) -------------------------------
MAX_AUX_ADC=500            # noise and post-signal amplitude limit
MAX_FULL_RANGE_ADC=10000   # full-waveform amplitude limit
REQUIRE_PEAK=0             # 1: also reject waveforms without a significant peak
MAX_WAVEFORMS=0            # waveforms per channel and run after the rate cut; 0 = all

# --- fit (fit/waveform_fits/fitting_bertolini_avg.py) ----------------------
MODULES="M8"               # M5 needs 2050 2051, M6 2060 2061, M8 2080 2081

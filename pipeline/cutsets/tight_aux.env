# Example variation: baseline with a tighter noise/post-signal cut.
# Only waveform-selection settings differ, so the coincidence output of
# baseline.env is reused and this pass is quick. It shares baseline's
# selection folder (same coincidence tag): run it with --force selection,
# which replaces baseline's selection there; baseline's fit is kept.
TRIGGER=inverse_coinc
WINDOW_TICKS=10
MIN_AMPLITUDE_ADC=0
RATE_THRESHOLDS=analysis/RateAnalysis_data_292kV
INTERVALS=coincidence/waveform_intervals.ini
MAX_AUX_ADC=250
MAX_FULL_RANGE_ADC=10000
MODULES="M5 M6"
TEMPLATES=large_pulse         # or francesca; see baseline.env
